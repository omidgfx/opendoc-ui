{
  "name": "opendoc-ui",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/create-spa-fallback.mjs && node scripts/verify-single-bundle.mjs",
    "preview": "vite preview",
    "ai-gateway": "tsx server/ai-gateway.ts",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && tsc --noEmit && node scripts/verify-ui-contracts.mjs",
    "test": "tsx tests/run.ts && tsx tests/serialization-matrix.ts && tsx tests/swagger2-matrix.ts && tsx tests/async.ts && tsx tests/conformance.ts",
    "test:browser": "playwright test",
    "test:all": "npm run lint && npm test && npm run test:browser && npm run build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@scalar/openapi-parser": "0.24.17",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "dotenv": "^17.2.3",
    "emoji-datasource-apple": "16.0.0",
    "express": "^4.21.2",
    "js-yaml": "^5.2.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.5",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-svgr": "^5.2.0"
  }
}
