# Shared OpenDoc AI gateway settings for every framework example.
AI_GATEWAY_TOKEN=replace-with-a-long-random-token
AI_GATEWAY_ORIGINS=https://docs.example.com,http://localhost:3000
AI_GATEWAY_DEV_MODE=false

# Server-controlled OpenAI-compatible provider. Browser requests cannot override these.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-provider-key

# Optional exact client-selectable models. AI_MODEL must be included.
AI_GATEWAY_ALLOW_CLIENT_MODEL=false
AI_GATEWAY_ALLOWED_MODELS=gpt-4o-mini

# Request and resource limits.
AI_GATEWAY_RATE_LIMIT=30
AI_GATEWAY_MAX_CONCURRENT=4
AI_GATEWAY_MAX_MESSAGES=24
AI_GATEWAY_MAX_MESSAGE_CHARS=40000
AI_GATEWAY_MAX_CONTEXT_CHARS=250000
AI_GATEWAY_MAX_OUTPUT_TOKENS=2048
AI_GATEWAY_UPSTREAM_TIMEOUT_MS=60000
AI_GATEWAY_MAX_BODY_BYTES=1048576

# Optional OpenRouter attribution headers.
AI_SITE_URL=
AI_APP_NAME=OpenDoc UI

PORT=8787
AI_GATEWAY_BIND=0.0.0.0

# --- Managed AI mode --------------------------------------------------------
# When enabled, the gateway additionally serves the secret-free capability
# descriptor GET /api/ai/policy so OpenDoc UI self-configures: users get a
# working assistant with no profiles, no visible AI settings, and no
# authorization data in the browser. The same contract applies to every
# framework example here: implement GET /api/ai/policy returning
# {policyVersion:1, mode:"managed", ready:true, displayName, exposeModel,
#  provider|null, model|null, clientModelSelection:false, allowedSkillPacks,
#  allowCustomInstructions:false, limits:{requestsPerMinute}, auth:"ambient"}.
# Never include API keys, tokens, or upstream base URLs in the payload.
# AI_GATEWAY_MANAGED=false
# AI_GATEWAY_AUTH_MODE=ambient
# AI_GATEWAY_SUBJECT_HEADER=X-Forwarded-User
# AI_GATEWAY_DISPLAY_NAME=Assistant
# AI_GATEWAY_EXPOSE_MODEL=false
# AI_GATEWAY_LOCK_TEMPERATURE=true
# AI_GATEWAY_TEMPERATURE=0.2
# AI_GATEWAY_ALLOWED_SKILL_PACKS=openapi,rest-debugging,security,api-testing
