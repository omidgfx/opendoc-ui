# Remote specification loading (build-time Vite settings)
# Set true to compile and display "Load from URL" controls.
VITE_LOAD_FROM_URL=false
# Optional proxy template. {URL} receives the encoded full target URL. The
# configured scheme is replaced with the scheme serving OpenDoc UI.
# VITE_SPEC_DOWNLOADER=https://proxy.example.com/download?spec_url={URL}

# OpenDoc UI gateway hardening
# Required outside an explicitly trusted local development run.
AI_GATEWAY_TOKEN=replace-with-a-long-random-token
# Comma-separated exact browser origins. Do not use * in production.
AI_GATEWAY_ORIGIN=http://localhost:3000
AI_GATEWAY_PORT=8787

# Server-side provider configuration. The browser never supplies these values.
AI_PROVIDER=ollama
AI_MODEL=llama3.2
# AI_API_KEY=
# AI_BASE_URL=

# Optional exact allowlisted client model selection. AI_PROVIDER remains server-controlled.
# AI_GATEWAY_ALLOW_CLIENT_MODEL=true
# AI_GATEWAY_ALLOWED_MODELS=openrouter/free,openai/gpt-4o-mini

# Resource limits
AI_GATEWAY_RATE_LIMIT=30
AI_GATEWAY_MAX_CONCURRENT=4
AI_GATEWAY_MAX_MESSAGES=24
AI_GATEWAY_MAX_MESSAGE_CHARS=40000
AI_GATEWAY_MAX_CONTEXT_CHARS=250000
AI_GATEWAY_MAX_OUTPUT_TOKENS=2048
AI_GATEWAY_UPSTREAM_TIMEOUT_MS=60000

# Local only: explicitly opt into no-token development mode instead of relying
# on NODE_ENV being inferred.
# AI_GATEWAY_DEV_MODE=true
