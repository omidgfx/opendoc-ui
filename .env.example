# Frontend build options
# Source maps are always disabled for production builds.
# Apple Emoji metadata and the embedded sprite are excluded by default. Set
# this to false only when the consistent Apple rendering is worth the larger bundle.
VITE_DISABLE_APPLE_EMOJIS=true

# Set true to compile and display "Load from URL" controls.
VITE_LOAD_FROM_URL=false
# Optional proxy template. {URL} receives the encoded full target URL. The
# configured scheme is replaced with the scheme serving OpenDoc UI.
# VITE_SPEC_DOWNLOADER=https://proxy.example.com/download?spec_url={URL}

# Docker Compose options; helper scripts accept the same process environment variables
OPENDOC_IMAGE_NAME=opendoc-ui
OPENDOC_CONTAINER_NAME=opendoc-ui
OPENDOC_PORT=3000
OPENDOC_CONFIG_FILE=./docker/config.json
OPENDOC_RESTART_POLICY=unless-stopped

# OpenDoc UI gateway hardening
# Required outside an explicitly trusted local development run.
AI_GATEWAY_TOKEN=replace-with-a-long-random-token
# Comma-separated exact browser origins. Do not use * in production.
AI_GATEWAY_ORIGIN=http://localhost:3000
AI_GATEWAY_PORT=8787

# Server-side provider configuration. The browser never supplies these values.
AI_PROVIDER=ollama
AI_MODEL=llama3.2
# AI_API_KEY=
# AI_BASE_URL=

# Optional exact allowlisted client model selection. AI_PROVIDER remains server-controlled.
# AI_GATEWAY_ALLOW_CLIENT_MODEL=true
# AI_GATEWAY_ALLOWED_MODELS=openrouter/free,openai/gpt-4o-mini

# Resource limits
AI_GATEWAY_RATE_LIMIT=30
AI_GATEWAY_MAX_CONCURRENT=4
AI_GATEWAY_MAX_MESSAGES=24
AI_GATEWAY_MAX_MESSAGE_CHARS=40000
AI_GATEWAY_MAX_CONTEXT_CHARS=250000
AI_GATEWAY_MAX_OUTPUT_TOKENS=2048
AI_GATEWAY_UPSTREAM_TIMEOUT_MS=60000

# Local only: explicitly opt into no-token development mode instead of relying
# on NODE_ENV being inferred.
# AI_GATEWAY_DEV_MODE=true

# --- Managed AI mode (backend-owned, zero-config for users) -----------------
# Publishes a secret-free capability descriptor at GET /api/ai/policy so
# OpenDoc UI self-configures: no user profiles, no visible AI settings, and
# no authorization data in the browser. In ambient mode the perimeter in
# front of the gateway (SSO session / reverse proxy) authenticates users.
# Requires AI_PROVIDER/AI_MODEL (and AI_API_KEY unless the provider is ollama).
# AI_GATEWAY_MANAGED=true
# Authentication mode: ambient (default; perimeter-authenticated) or token
# (the classic AI_GATEWAY_TOKEN bearer check still applies).
# AI_GATEWAY_AUTH_MODE=ambient
# Optional identity header from the edge; keys rate limits per user instead
# of per IP. Must be a valid HTTP header name.
# AI_GATEWAY_SUBJECT_HEADER=X-Forwarded-User
# User-facing assistant name (the only identity users see).
# AI_GATEWAY_DISPLAY_NAME=Assistant
# Publish provider/model identity in the policy descriptor (default: masked).
# AI_GATEWAY_EXPOSE_MODEL=false
# Server-side generation lock: ignore client temperature and use the value
# below (default: locked).
# AI_GATEWAY_LOCK_TEMPERATURE=true
# AI_GATEWAY_TEMPERATURE=0.2
# Curated skill packs advertised to the client.
# AI_GATEWAY_ALLOWED_SKILL_PACKS=openapi,rest-debugging,security,api-testing

# Frontend managed AI mode. Default is a silent same-origin probe of
# /api/ai/policy; set VITE_AI_MANAGED=false to hard-disable probing, or true
# to start before config.json resolves. Companies using config.json should
# prefer the runtime block: { "ai": { "managed": { "enabled": true } } }.
# VITE_AI_MANAGED=
# VITE_AI_MANAGED_POLICY_URL=/api/ai/policy
